      "parameters": {
        "jsCode": "// Extract lead submission data handling both direct and nested formats\nconst body = $input.item.json.body || $input.item.json;\n\nconst name = String(body.name || body.fullName || body['Full Name'] || 'Valued Lead').trim();\nconst email = String(body.email || body.emailAddress || body['Email'] || '').trim();\nconst companyName = String(body.companyName || body.company || body.company_name || body['Company Name'] || 'N/A').trim();\nconst interestedService = String(body.interestedService || body.service || body.interested_service || body['Interested Service'] || 'General Inquiry').trim();\nconst message = String(body.message || body.notes || body['Message'] || '').trim();\nconst now = new Date();\nconst submissionDate = now.toISOString().replace('T', ' ').substring(0, 19);\nconst initialStatus = 'Pending';\n\nreturn [{\n  json: {\n    name,\n    email,\n    companyName,\n    interestedService,\n    message,\n    submissionDate,\n    initialStatus\n  }\n}];"
      },
